rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(profileData) {
      return isSignedIn() && (
        profileData.ownerUid == request.auth.uid ||
        request.auth.token.email == 'Akram111000Akram@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'Akram111000Akram@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Profiles collection:
    // - Public visitors can read active smart profiles (for /p/:slug NFC & QR scan traffic)
    // - Authenticated owners can read/create/update their assigned profile records
    match /profiles/{profileId} {
      allow get: if isValidId(profileId);
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. NFC Tokens collection:
    // - Public card lookup on NFC tap (/p/:cardToken and /activate)
    // - Authenticated users can activate/bind an unassigned token to their profile
    // - Token creation and deletion are strictly restricted to project owner / admin
    match /nfc_tokens/{tokenId} {
      allow get: if isValidId(tokenId);
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && resource.data.status == 'unassigned');
      allow delete: if isAdmin();
    }

    // 3. Syrian Events collection:
    // - Public read for cultural, business, and heritage events agenda
    // - Authorized project owner can manage events
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Products collection (NFC Smart Hardware Store):
    // - Public read for store catalog (cards, stands, keychains, tags)
    // - Project owner manages inventory and pricing
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Directory collection (National Syrian Landmarks & Businesses):
    match /directory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
